HOST_ROOT="/absolute/path/to/AI Secure Environment"
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest
PAPERCLIP_PORT=3100
OPERATOR_PORT=3199
MLX_HOST=127.0.0.1
MLX_PORT=8080
MLX_MODEL=mlx-community/DeepSeek-R1-Distill-Qwen-7B-4bit
LOCAL_LLM_API_KEY=change-me
OPERATOR_TOKEN=change-me
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=change-me
PAPERCLIP_AGENT_JWT_SECRET=change-me
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=change-me
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
OPENAI_API_KEY=change-me
OPENAI_BASE_URL=http://host.docker.internal:8080/v1
OPENCODE_ALLOW_ALL_MODELS=true
PAPERCLIP_OPENCODE_SMALL_MODEL=mlx/mlx-community/DeepSeek-R1-Distill-Qwen-7B-4bit
PAPERCLIP_OPENCODE_PROVIDERS='{"mlx":{"npm":"@ai-sdk/openai-compatible","name":"MLX","options":{"baseURL":"http://host.docker.internal:8080/v1","apiKey":"{env:LOCAL_LLM_API_KEY}"},"models":{"mlx-community/DeepSeek-R1-Distill-Qwen-7B-4bit":{"name":"Qwen Distill 7B"}}}}'
PAPERCLIP_ADAPTER_MODELS='{"opencode_local":[{"id":"mlx/mlx-community/DeepSeek-R1-Distill-Qwen-7B-4bit","label":"MLX Qwen Distill 7B"}]}'
SECENV_OPERATOR_URL=http://operator:3199
