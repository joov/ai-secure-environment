HOST_ROOT="/absolute/path/to/AI Secure Environment"
MLX_HOST=127.0.0.1
MLX_PORT=8080
MLX_MODEL=mlx-community/DeepSeek-R1-Distill-Qwen-7B-4bit
LOCAL_LLM_API_KEY=change-me
SECENV_PROXY_PORT=8081

# AI-Security-PoC
# The LiteLLM master key is derived as sk-${LOCAL_LLM_API_KEY} in docker-compose.yml.
# MLX_API_KEY only matters if the local mlx_lm.server is started with authentication.
MLX_API_KEY=not-needed
IMMUDB_ADMIN_PASSWORD=change-me
