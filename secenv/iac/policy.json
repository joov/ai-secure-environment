{
  "network": {
    "sandbox": [
      "secenv_internal"
    ],
    "llm-proxy": [
      "secenv_internal",
      "secenv_egress"
    ],
    "presidio-analyzer": [
      "secenv_internal"
    ],
    "presidio-anonymizer": [
      "secenv_internal"
    ],
    "opa": [
      "secenv_internal"
    ],
    "immudb": [
      "secenv_internal"
    ],
    "test-agent": [
      "secenv_internal"
    ],
    "gitleaks": []
  },
  "egress": [
    "host.docker.internal:8080"
  ],
  "paths": [
    "/v1/models",
    "/v1/chat/completions"
  ],
  "pathsEnforcement": {
    "status": "not-enforced-at-gateway",
    "note": "The hand-written proxy allowlisted these paths itself. LiteLLM's equivalent (general_settings.allowed_routes) is enterprise-licensed, so the list above describes intended use only. Actual containment is the network layer: the gateway port is bound to 127.0.0.1 and every other service sits on the internal, egress-less network."
  },
  "dockerSocket": false,
  "readOnlyRoot": true,
  "gateway": {
    "implementation": "litellm",
    "deployments": 1,
    "modelGroupAlias": {
      "local-mlx": "mlx-community/DeepSeek-R1-Distill-Qwen-7B-4bit"
    },
    "rateLimit": {
      "scope": "per-deployment",
      "rpm": 30,
      "tpm": 20000,
      "maxParallelRequests": 4,
      "globalMaxParallelRequests": 8,
      "note": "Protects the upstream MLX server. Not per caller: every client shares the single master key and therefore the single budget. Per-caller limits need LiteLLM virtual keys, which need Postgres."
    },
    "guardrails": [
      "presidio-pii-mask"
    ],
    "retries": 0
  },
  "toolPolicy": {
    "engine": "opa",
    "package": "secenv.tools",
    "decisionPath": "/v1/data/secenv/tools/decision",
    "default": "deny",
    "deterministic": true,
    "workspaceRoot": "/workspace",
    "secondGate": "test_agent.contained() re-checks the resolved path, catching symlink escapes the policy cannot see"
  },
  "audit": {
    "ledger": "immudb",
    "database": "defaultdb",
    "keyPrefix": "secenv/",
    "storage": "named volume secenv_immudb_data",
    "hashChain": true,
    "fallback": "/logs/agent_audit.log",
    "failClosed": false
  },
  "secretScanner": {
    "tool": "gitleaks",
    "scans": [
      "workspace",
      "logs"
    ],
    "report": "/reports (./reports)",
    "network": "none",
    "config": "ai-security-poc/gitleaks.toml"
  }
}
